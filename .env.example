# Database (managed Postgres)
DATABASE_URL=postgres://leadz:leadz@localhost:5432/leadz

# Web app
PORT=3000
# public URL; used in unsubscribe links
APP_BASE_URL=https://leadz.puretech.example
SESSION_SECRET=change-me-long-random
# never rotate: old opt-out links must keep working
UNSUBSCRIBE_SECRET=change-me-long-random
# sent by the website check-up form as X-Webhook-Secret
FORM_WEBHOOK_SECRET=change-me
# COOKIE_SECURE=1                             # defaults to on when APP_BASE_URL is https

# Lead data
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
NY_OPEN_DATA_APP_TOKEN=
# NY_FILINGS_DATASET=n9v6-gdp6

# Drafting (Claude API)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Sending: Gmail API on the outreach Workspace mailbox (OAuth client + refresh token
# with the gmail.send and gmail.readonly scopes)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDER_EMAIL=maria@outreach.puretech.example
SENDER_NAME=Maria Lopez
# failed-send alerts
ADMIN_ALERT_EMAIL=j@puretech.example
# reply notifications for the outreach lead
REPLY_NOTIFY_EMAIL=
# log sends instead of sending; remove to go live
DRY_RUN=1

# Run the scheduled jobs inside the web process (single-service hosts like Railway)
# RUN_JOBS=1

# Optional job schedules (cron, Eastern time)
# WEEKLY_CRON="0 5 * * 1"
# SCHEDULER_CRON="*/10 * * * *"
# WATCHER_CRON="5-59/10 * * * *"
# MAINTENANCE_CRON="30 3 * * *"
