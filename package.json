{
  "name": "leadz",
  "version": "0.1.0",
  "private": true,
  "description": "PureTech lead generator and email scheduler",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "dev:worker": "tsx --env-file-if-exists=.env src/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
